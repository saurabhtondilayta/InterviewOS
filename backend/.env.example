# Copy to backend/.env and fill in. Never commit the real .env file.
ENVIRONMENT=development

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only secret. Bypasses Row Level Security - never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
RESUME_BUCKET=resumes

# AI provider (server-only secret). Any OpenAI-compatible API with JSON-schema output.
# Groq (free tier): key from https://console.groq.com/keys
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_CHAT_MODEL=openai/gpt-oss-120b
# xAI Grok alternative: AI_BASE_URL=https://api.x.ai/v1  AI_MODEL=grok-4.7  AI_CHAT_MODEL=grok-4.20-0309-non-reasoning
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
# Groq gpt-oss: 'low' keeps hidden reasoning short (faster, fits free-tier token limits). Leave empty for xAI.
AI_REASONING_EFFORT=low

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Per-user AI limits
AI_REQUESTS_PER_HOUR=60
AI_REQUESTS_PER_DAY=300
RESUME_ANALYSES_PER_DAY=10

# --- Company hiring ---
# Public frontend URL, used in invitation emails and links
APP_URL=http://localhost:5173
# SMTP for invitation emails (Gmail: smtp.gmail.com:587 with an App Password). Leave empty to
# skip email; HR can still copy invitation links from the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=InterviewOS
# Optional TURN relay for live video on strict networks (STUN alone works on most home/mobile networks)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
PROCTORING_BUCKET=proctoring
